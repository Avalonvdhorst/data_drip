<div class="ap-shell"
     data-backfill-run-updates
     data-backfill-run-id="<%= @backfill_run.id %>">

  <%# ── Sidebar ── %>
  <aside class="ap-sidebar">
    <%= link_to backfill_runs_path, class: "ap-logo-wrap" do %>
      <div class="ap-logo-icon">
        <svg viewBox="0 0 56 38" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="dd-grad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="10%" stop-color="#f72585"/>
              <stop offset="50%" stop-color="#b5179e"/>
              <stop offset="90%" stop-color="#7209b7"/>
            </linearGradient>
          </defs>
          <path d="M14 0 C14 0 26 16 26 22 C26 29 20.6 34 14 34 C7.4 34 2 29 2 22 C2 16 14 0 14 0Z" fill="url(#dd-grad)" opacity="1"/>
          <path d="M32 6 C32 6 41 18 41 24 C41 29.5 37 33.5 32 33.5 C27 33.5 23 29.5 23 24 C23 18 32 6 32 6Z" fill="url(#dd-grad)" opacity="0.65"/>
          <path d="M47 14 C47 14 53 22 53 26 C53 29.8 50.3 33 47 33 C43.7 33 41 29.8 41 26 C41 22 47 14 47 14Z" fill="url(#dd-grad)" opacity="0.35"/>
        </svg>
      </div>
      <span class="ap-logo-text">data<span class="ap-logo-drip">drip</span></span>
    <% end %>

    <div class="ap-dark-toggle-area">
      <span class="ap-toggle-label">Theme</span>
      <div class="ap-theme-switch" role="radiogroup" aria-label="Theme">
        <button type="button" class="ap-theme-opt" data-theme="light" role="radio" aria-label="Light" title="Light">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4"/>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
          </svg>
        </button>
        <button type="button" class="ap-theme-opt" data-theme="auto" role="radio" aria-label="Auto (follow system)" title="Auto (follow system)">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="14" rx="2"/>
            <path d="M8 22h8M12 18v4"/>
          </svg>
        </button>
        <button type="button" class="ap-theme-opt" data-theme="dark" role="radio" aria-label="Dark" title="Dark">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </button>
      </div>
    </div>

    <nav class="ap-nav">
      <%= link_to backfill_runs_path, class: "ap-nav-item ap-nav-active" do %>
        <svg viewBox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
          <path d="M8.354 1.146a.5.5 0 0 0-.708 0l-6 6A.5.5 0 0 0 1.5 8v5a.5.5 0 0 0 .5.5h3.5a.5.5 0 0 0 .5-.5v-3h4v3a.5.5 0 0 0 .5.5H14a.5.5 0 0 0 .5-.5V8a.5.5 0 0 0-.146-.354L8.354 1.146z"/>
        </svg>
        Backfill Runs
      <% end %>
      <%= link_to new_backfill_run_path, class: "ap-nav-item" do %>
        <svg viewBox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
          <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>
        </svg>
        New Run
      <% end %>
    </nav>

    <div class="ap-sidebar-user">
      <div class="ap-user-avatar">
        <%= find_current_backfiller.send(DataDrip.backfiller_name_attribute).to_s.first(2).upcase %>
      </div>
      <span class="ap-user-name"><%= find_current_backfiller.send(DataDrip.backfiller_name_attribute) %></span>
    </div>
  </aside>

  <%# ── Main ── %>
  <main class="ap-main">
    <div class="ap-content">

      <%# Flash messages %>
      <% flash.each do |key, value| %>
        <div class="<%= key == 'notice' ? 'ap-flash-notice' : 'ap-flash-alert' %>"><%= value %></div>
      <% end %>

      <%# Breadcrumb %>
      <div class="ap-page-header">
        <div class="ap-breadcrumb">
          <%= link_to "Backfill Runs", backfill_runs_path %>
          <span>›</span>
          <span><%= @backfill_run.backfill_class_name %></span>
        </div>
      </div>

      <%# ── Run header card ── %>
      <div class="ap-run-header">
        <div class="ap-run-title-row">
          <div>
            <div class="ap-run-name"><%= @backfill_run.backfill_class_name %></div>
            <div class="ap-run-by">by <%= @backfill_run.backfiller_name %></div>
          </div>
          <div style="display:flex;align-items:center;gap:12px;">
            <span data-target="status"><%= status_tag(@backfill_run.status) %></span>
            <div data-target="actionButton">
              <% if @backfill_run.running? %>
                <%= button_to "Stop Run",
                    stop_backfill_run_path(@backfill_run),
                    method: :post,
                    data: { confirm: "Are you sure you want to stop this backfill run?", disable_with: "Stopping…" },
                    class: "ap-btn-danger" %>
              <% elsif @backfill_run.enqueued? %>
                <%= button_to "Delete",
                    backfill_run_path(@backfill_run),
                    method: :delete,
                    data: { confirm: "Are you sure you want to delete this run?", disable_with: "Deleting…" },
                    class: "ap-btn-danger" %>
              <% end %>
            </div>
          </div>
        </div>

        <div class="ap-run-meta-grid">
          <div>
            <div class="ap-meta-label">Processed</div>
            <div class="ap-meta-value">
              <span data-target="processedCount"><%= @backfill_run.processed_count %></span>
              <% if @backfill_run.amount_of_elements %>
                <span style="color:var(--ap-muted);font-size:12px;font-weight:400;"> / max <%= @backfill_run.amount_of_elements %></span>
              <% end %>
            </div>
          </div>
          <div>
            <div class="ap-meta-label">Total</div>
            <div class="ap-meta-value" data-target="totalCount"><%= @backfill_run.total_count %></div>
          </div>
          <div>
            <div class="ap-meta-label">Batch Size</div>
            <div class="ap-meta-value"><%= @backfill_run.batches.first&.batch_size || @backfill_run.batch_size %></div>
          </div>
          <div>
            <div class="ap-meta-label">Created</div>
            <div class="ap-meta-value"><%= format_datetime_in_user_timezone(@backfill_run.created_at, @user_timezone) %></div>
          </div>
          <div>
            <div class="ap-meta-label">Start At</div>
            <div class="ap-meta-value"><%= format_datetime_in_user_timezone(@backfill_run.start_at, @user_timezone) %></div>
          </div>
          <% if @backfill_run.options.present? %>
            <div>
              <div class="ap-meta-label">Options</div>
              <div class="ap-meta-value" style="font-size:12.5px;">
                <% @backfill_run.options.each do |key, value| %>
                  <% next if value.blank? %>
                  <span style="display:block;"><strong><%= key %></strong> = <%= value %></span>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <%# ── Progress chip ── %>
      <% total = @backfill_run.total_count.to_i
         processed = @backfill_run.processed_count.to_i
         pct = total > 0 ? (processed * 100.0 / total).round(1) : 0 %>
      <div class="ap-progress-chip">
        <div class="ap-progress-head">
          <span class="ap-progress-label">Progress</span>
          <span class="ap-progress-pct" data-target="progressBar"><%= pct %>%</span>
        </div>
        <div class="ap-progress-bar-wrap">
          <div class="ap-progress-bar-track" data-target="progressBarTrack" style="width:<%= pct %>%"></div>
        </div>
        <div style="margin-top:6px;font-size:12px;color:var(--ap-muted);">
          <span data-target="processedCount"><%= @backfill_run.processed_count %></span>
          of
          <span data-target="totalCount"><%= @backfill_run.total_count %></span>
          elements
        </div>
      </div>

      <%# ── Insights grid ── %>
      <div class="ap-insights-section">
        <div class="ap-insights-label">Insights</div>
        <div class="ap-insights-grid">
          <div class="ap-insight-chip">
            <div class="ap-insight-chip-label">Total Run Time</div>
            <div class="ap-insight-chip-value" data-target="runDuration">
              <%= format_insight_duration(@backfill_run.insight_run_duration_seconds) %>
            </div>
          </div>
          <div class="ap-insight-chip">
            <div class="ap-insight-chip-label">Avg Time / Batch</div>
            <div class="ap-insight-chip-value" data-target="averageBatchDuration">
              <%= format_insight_duration(@backfill_run.insight_average_batch_duration_seconds) %>
            </div>
          </div>
          <div class="ap-insight-chip">
            <div class="ap-insight-chip-label">Elements / Second</div>
            <div class="ap-insight-chip-value" data-target="elementsPerSecond">
              <%= format_insight_elements_per_second(@backfill_run.insight_elements_per_second) %>
            </div>
          </div>
        </div>
      </div>

      <%# ── Batches table ── %>
      <div class="ap-table-wrap">
        <div style="padding:16px 20px 12px;display:flex;align-items:baseline;gap:10px;border-bottom:1px solid var(--ap-border);">
          <span class="ap-section-title">Batches</span>
          <span class="ap-section-subtitle">Status of each batch in this run</span>
        </div>
        <table class="ap-table">
          <thead>
            <tr>
              <th class="ap-th-first">Status</th>
              <th>Batch Size</th>
              <th>Finished At</th>
              <th>Start ID</th>
              <th>Finish ID</th>
              <th class="ap-th-last">Errors</th>
            </tr>
          </thead>
          <tbody data-target="batchesTable">
            <%= render 'batches_table', backfill_run: @backfill_run, batches: @batches %>
          </tbody>
        </table>
      </div>

    </div>
  </main>

</div>
