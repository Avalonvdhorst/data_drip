<div class="ap-shell">

  <%# ── Sidebar ── %>
  <aside class="ap-sidebar">
    <%= link_to backfill_runs_path, class: "ap-logo-wrap" do %>
      <div class="ap-logo-icon">
        <svg viewBox="0 0 56 38" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="dd-grad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="10%" stop-color="#f72585"/>
              <stop offset="50%" stop-color="#b5179e"/>
              <stop offset="90%" stop-color="#7209b7"/>
            </linearGradient>
          </defs>
          <path d="M14 0 C14 0 26 16 26 22 C26 29 20.6 34 14 34 C7.4 34 2 29 2 22 C2 16 14 0 14 0Z" fill="url(#dd-grad)" opacity="1"/>
          <path d="M32 6 C32 6 41 18 41 24 C41 29.5 37 33.5 32 33.5 C27 33.5 23 29.5 23 24 C23 18 32 6 32 6Z" fill="url(#dd-grad)" opacity="0.65"/>
          <path d="M47 14 C47 14 53 22 53 26 C53 29.8 50.3 33 47 33 C43.7 33 41 29.8 41 26 C41 22 47 14 47 14Z" fill="url(#dd-grad)" opacity="0.35"/>
        </svg>
      </div>
      <span class="ap-logo-text">data<span class="ap-logo-drip">drip</span></span>
    <% end %>

    <div class="ap-dark-toggle-area">
      <span class="ap-toggle-label">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
        Dark mode
      </span>
      <button class="ap-toggle-btn" id="dark-toggle" role="switch" aria-label="Toggle dark mode">
        <div class="ap-toggle-track" id="ap-toggle-track">
          <div class="ap-toggle-thumb"></div>
        </div>
      </button>
    </div>

    <nav class="ap-nav">
      <%= link_to backfill_runs_path, class: "ap-nav-item ap-nav-active" do %>
        <svg viewBox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
          <path d="M8.354 1.146a.5.5 0 0 0-.708 0l-6 6A.5.5 0 0 0 1.5 8v5a.5.5 0 0 0 .5.5h3.5a.5.5 0 0 0 .5-.5v-3h4v3a.5.5 0 0 0 .5.5H14a.5.5 0 0 0 .5-.5V8a.5.5 0 0 0-.146-.354L8.354 1.146z"/>
        </svg>
        Backfill Runs
      <% end %>
      <%= link_to new_backfill_run_path, class: "ap-nav-item" do %>
        <svg viewBox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
          <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>
        </svg>
        New Run
      <% end %>
    </nav>

    <div class="ap-sidebar-user">
      <div class="ap-user-avatar">
        <%= find_current_backfiller.send(DataDrip.backfiller_name_attribute).to_s.first(2).upcase %>
      </div>
      <span class="ap-user-name"><%= find_current_backfiller.send(DataDrip.backfiller_name_attribute) %></span>
    </div>
  </aside>

  <%# ── Main ── %>
  <main class="ap-main">
    <div class="ap-content">

      <%# Flash messages %>
      <% flash.each do |key, value| %>
        <div class="<%= key == 'notice' ? 'ap-flash-notice' : 'ap-flash-alert' %>"><%= value %></div>
      <% end %>

      <%# Page header %>
      <div class="ap-page-header" style="display:flex;align-items:center;justify-content:space-between;">
        <div>
          <h1 class="ap-page-title">Backfill Runs</h1>
          <p class="ap-page-subtitle">Monitor and manage your data backfills</p>
        </div>
        <%= link_to new_backfill_run_path, class: "ap-btn" do %>
          <svg viewBox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/></svg>
          New Backfill Run
        <% end %>
      </div>

      <%# Tabs %>
      <div class="ap-tabs-row" style="margin-bottom:16px;">
        <%= link_to backfill_runs_path(tab: 'my_runs'),
            class: "ap-tab-link #{@current_tab == 'my_runs' ? 'ap-tab-active' : ''}",
            data: { tab: 'my_runs' } do %>
          My Runs
        <% end %>
        <%= link_to backfill_runs_path(tab: 'all'),
            class: "ap-tab-link #{@current_tab == 'all' ? 'ap-tab-active' : ''}",
            data: { tab: 'all' } do %>
          All Runs
        <% end %>
      </div>

      <%# Table %>
      <div class="ap-table-wrap">
        <table class="ap-table">
          <thead>
            <tr>
              <th class="ap-th-first">Name</th>
              <th>Status</th>
              <th>Batch Size</th>
              <th>Backfiller</th>
              <th>Created</th>
            </tr>
          </thead>
          <tbody>
            <% @backfill_runs.each do |backfill_run| %>
              <tr class="ap-table-row-link" onclick="window.location='<%= backfill_run_path(backfill_run) %>'" style="cursor:pointer;">
                <td class="ap-td-first"><%= backfill_run.backfill_class_name %></td>
                <td><%= status_tag(backfill_run.status) %></td>
                <td style="color:var(--ap-muted)"><%= backfill_run.batch_size %></td>
                <td style="color:var(--ap-muted)"><%= backfill_run.backfiller_name %></td>
                <td style="color:var(--ap-muted)"><%= format_datetime_in_user_timezone(backfill_run.created_at, @user_timezone) %></td>
              </tr>
            <% end %>
            <% if @backfill_runs.empty? %>
              <tr>
                <td colspan="5" style="text-align:center;padding:40px 20px;color:var(--ap-muted);font-size:13.5px;">
                  No backfill runs found.
                  <%= link_to "Create one →", new_backfill_run_path, style: "color:var(--ap-accent);font-weight:600;" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>

        <%# Pagination %>
        <% if @pagination[:total_pages] > 1 %>
          <div class="ap-pagination">
            <span class="ap-pagination-info">
              Showing <%= (@pagination[:current_page] - 1) * @pagination[:per_page] + 1 %>–<%= [@pagination[:current_page] * @pagination[:per_page], @pagination[:total_count]].min %>
              of <%= @pagination[:total_count] %> runs
            </span>
            <div class="ap-pagination-pages">
              <% if @pagination[:has_previous_page] %>
                <%= link_to "←", url_for({ tab: @current_tab, page: @pagination[:previous_page] }), class: "ap-page-btn" %>
              <% end %>
              <% @pagination[:page_range].each do |page_num| %>
                <%= link_to page_num, url_for({ tab: @current_tab, page: page_num }),
                    class: "ap-page-btn #{page_num == @pagination[:current_page] ? 'ap-page-btn-active' : ''}" %>
              <% end %>
              <% if @pagination[:has_next_page] %>
                <%= link_to "→", url_for({ tab: @current_tab, page: @pagination[:next_page] }), class: "ap-page-btn" %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

    </div>
  </main>

</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var userTimezone = Intl.DateTimeFormat().resolvedOptions().timeZone;
    var currentTimezone = '<%= session[:user_timezone] %>';

    if (currentTimezone !== userTimezone) {
      fetch('<%= set_timezone_backfill_runs_path %>', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
        },
        body: JSON.stringify({ timezone: userTimezone })
      });
    }

    var tabLinks = document.querySelectorAll('.ap-tab-link');
    var tableWrap = document.querySelector('.ap-table-wrap');

    tabLinks.forEach(function(link) {
      link.addEventListener('click', function() {
        if (tableWrap) {
          tableWrap.style.opacity = '0.6';
          tableWrap.style.pointerEvents = 'none';
        }
      });
    });
  });
</script>
