<% batches = local_assigns[:batches] || @batches || backfill_run.batches.order(created_at: :desc).limit(20) %>
<% batches.each do |batch| %>
  <tr>
    <td class="ap-td-first"><%= status_tag(batch.status) %></td>
    <td style="color:var(--ap-muted)"><%= batch.batch_size %></td>
    <td style="color:var(--ap-muted)"><%= format_datetime_in_user_timezone(batch.updated_at, @user_timezone) %></td>
    <td style="color:var(--ap-muted);font-family:monospace;font-size:12.5px;"><%= batch.start_id %></td>
    <td style="color:var(--ap-muted);font-family:monospace;font-size:12.5px;"><%= batch.finish_id %></td>
    <td class="ap-td-last" style="color:#dc2626;font-size:12.5px;max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= batch.error_message %></td>
  </tr>
<% end %>
