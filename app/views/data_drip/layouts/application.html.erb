<!DOCTYPE html>
<html>
<head>
  <title>DataDrip</title>
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 56 38'%3E%3Cdefs%3E%3ClinearGradient id='g' x1='0%25' y1='0%25' x2='100%25' y2='100%25'%3E%3Cstop offset='10%25' stop-color='%23f72585'/%3E%3Cstop offset='50%25' stop-color='%23b5179e'/%3E%3Cstop offset='90%25' stop-color='%237209b7'/%3E%3C/linearGradient%3E%3C/defs%3E%3Cpath d='M14 0 C14 0 26 16 26 22 C26 29 20.6 34 14 34 C7.4 34 2 29 2 22 C2 16 14 0 14 0Z' fill='url(%23g)'/%3E%3Cpath d='M32 6 C32 6 41 18 41 24 C41 29.5 37 33.5 32 33.5 C27 33.5 23 29.5 23 24 C23 18 32 6 32 6Z' fill='url(%23g)' opacity='0.65'/%3E%3Cpath d='M47 14 C47 14 53 22 53 26 C53 29.8 50.3 33 47 33 C43.7 33 41 29.8 41 26 C41 22 47 14 47 14Z' fill='url(%23g)' opacity='0.35'/%3E%3C/svg%3E">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag 'data_drip/tailwind', media: :all, data: { turbo_track: :reload }  %>
  <%= javascript_importmap_tags "application", importmap: DataDrip.importmap  %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">
  <style>
    body { font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; margin: 0; }
  </style>
  <%# Prevent flash of wrong theme — applied before any paint %>
  <script>
    (function() {
      var pref = localStorage.getItem('dd-theme');
      if (pref !== 'light' && pref !== 'dark' && pref !== 'auto') {
        var legacy = localStorage.getItem('dd-dark');
        if (legacy === 'true') pref = 'dark';
        else if (legacy === 'false') pref = 'light';
        else pref = 'auto';
      }
      var isDark = pref === 'dark' || (pref === 'auto' && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
      if (isDark) document.documentElement.classList.add('dark');
    })();
  </script>
</head>
<body>
  <%= yield %>
  <script>
    function ddGetThemePref() {
      var pref = localStorage.getItem('dd-theme');
      if (pref === 'light' || pref === 'dark' || pref === 'auto') return pref;
      var legacy = localStorage.getItem('dd-dark');
      if (legacy === 'true') return 'dark';
      if (legacy === 'false') return 'light';
      return 'auto';
    }

    function ddSystemPrefersDark() {
      return !!(window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
    }

    function ddApplyTheme(pref) {
      var isDark = pref === 'dark' || (pref === 'auto' && ddSystemPrefersDark());
      document.documentElement.classList.toggle('dark', isDark);
      var opts = document.querySelectorAll('.ap-theme-opt');
      for (var i = 0; i < opts.length; i++) {
        var active = opts[i].getAttribute('data-theme') === pref;
        opts[i].classList.toggle('ap-theme-opt-active', active);
        opts[i].setAttribute('aria-checked', active ? 'true' : 'false');
      }
      try { localStorage.setItem('dd-theme', pref); } catch(e) {}
    }

    function ddSetupToggle() {
      var opts = document.querySelectorAll('.ap-theme-opt');
      if (!opts.length) return;
      ddApplyTheme(ddGetThemePref());
      for (var i = 0; i < opts.length; i++) {
        if (opts[i]._ddBound) continue;
        opts[i]._ddBound = true;
        opts[i].addEventListener('click', function(e) {
          ddApplyTheme(e.currentTarget.getAttribute('data-theme'));
        });
      }
    }

    if (window.matchMedia) {
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function() {
        if (ddGetThemePref() === 'auto') ddApplyTheme('auto');
      });
    }

    document.addEventListener('DOMContentLoaded', ddSetupToggle);
    document.addEventListener('turbo:load', ddSetupToggle);
    document.addEventListener('turbo:render', ddSetupToggle);
  </script>
</body>
</html>
